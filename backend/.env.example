# Copia este archivo a backend/.env y ajusta los valores.
NETSUREX_ENVIRONMENT=development
# Obligatoria en producción. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETSUREX_SECRET_KEY=
# SQLite por defecto. Para PostgreSQL: postgresql+psycopg://usuario:clave@host/netsurex (instala psycopg[binary])
# NETSUREX_DATABASE_URL=sqlite:///./netsurex.db
NETSUREX_CORS_ORIGINS=["http://localhost:5173"]
NETSUREX_TRUST_PROXY=false
# Servir el frontend compilado desde FastAPI (opcional): ruta absoluta a dist/
# NETSUREX_FRONTEND_DIST=/ruta/al/proyecto/dist

# Aviso por email de nuevas solicitudes (opcional)
NETSUREX_SMTP_HOST=
NETSUREX_SMTP_PORT=587
NETSUREX_SMTP_USER=
NETSUREX_SMTP_PASSWORD=
NETSUREX_SMTP_FROM=
NETSUREX_NOTIFY_EMAIL=
